#!/usr/bin/env bash
# From WSL2: cross-build the Windows console binary and run its self-test on the Windows host
# through WSL interop: scripts/windows-host-selftest
#
# WRITES OUTSIDE THE REPO: it copies the exe into a directory on the Windows side and the app
# creates its WebView2 profile under %APPDATA%. The session rule is "write only inside the repo
# unless told otherwise", so this refuses to run unless you opt in:
#     LUMEN_ALLOW_HOST_WRITE=1 scripts/windows-host-selftest
# It also puts real windows on the Windows desktop for about half a minute.
# Output: dist/selftest/windows-host-report.json
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
if [[ ${LUMEN_ALLOW_HOST_WRITE:-} != 1 ]]; then
  echo "refusing: this writes outside the repo and opens windows on the Windows desktop." >&2
  echo "re-run with LUMEN_ALLOW_HOST_WRITE=1 once you have agreed to that." >&2
  exit 1
fi
command -v cmd.exe >/dev/null || { echo "WSL interop is not available (see docs/windows-dev.md)" >&2; exit 1; }

"$root/scripts/build-binary" windows amd64 console
local_appdata=$(cd /mnt/c && cmd.exe /c "echo %LOCALAPPDATA%" 2>/dev/null | tr -d '\r\n')
win_dir="$local_appdata\\Temp\\lumen-selftest"
wsl_dir=$(wslpath -u "$win_dir")
mkdir -p "$wsl_dir" "$root/dist/selftest"
cp "$root/dist/bin/lumen-console_windows_amd64.exe" "$wsl_dir/lumen-console.exe"
rm -f "$wsl_dir/report.json"
set +e
(cd /mnt/c && "$wsl_dir/lumen-console.exe" -selftest -report "$win_dir\\report.json")
code=$?
set -e
[[ -f $wsl_dir/report.json ]] && cp "$wsl_dir/report.json" "$root/dist/selftest/windows-host-report.json"
echo "windows host selftest exit=$code; report: dist/selftest/windows-host-report.json"
exit "$code"
