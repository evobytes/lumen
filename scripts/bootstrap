#!/usr/bin/env bash
# Install pinned dev tools into ./.tools/bin (never globally).
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=tools.env
source "$root/scripts/tools.env"

export GOBIN="$root/.tools/bin"
mkdir -p "$GOBIN"

install() { # <module/cmd> <version> <binary>
  if [[ -x "$GOBIN/$3" ]] && "$GOBIN/$3" --version 2>&1 | grep -q "${2#v}" 2>/dev/null; then
    echo "ok   $3 $2"
    return
  fi
  echo "get  $3 $2"
  CGO_ENABLED=0 go install "$1@$2"
}

install github.com/goreleaser/nfpm/v2/cmd/nfpm "$NFPM_VERSION" nfpm
install github.com/golangci/golangci-lint/v2/cmd/golangci-lint "$GOLANGCI_LINT_VERSION" golangci-lint
install mvdan.cc/gofumpt "$GOFUMPT_VERSION" gofumpt
install golang.org/x/vuln/cmd/govulncheck "$GOVULNCHECK_VERSION" govulncheck
# wails3 (the CLI) is used only to generate the Windows resource file (icon, version, DPI manifest).
if [[ -x "$GOBIN/wails3" ]] && "$GOBIN/wails3" version 2>&1 | grep -q "${WAILS3_VERSION#v}"; then
  echo "ok   wails3 $WAILS3_VERSION"
else
  echo "get  wails3 $WAILS3_VERSION"
  CGO_ENABLED=0 go install "github.com/wailsapp/wails/v3/cmd/wails3@$WAILS3_VERSION"
fi
# goimports has no --version; install unconditionally (cached by the module cache).
CGO_ENABLED=0 go install "golang.org/x/tools/cmd/goimports@$GOIMPORTS_VERSION"
echo "tools in $GOBIN"
# Developer machines also get the pre-commit hook (CI has no use for it).
[[ -n ${CI:-} ]] || "$root/scripts/install-hooks"
